# 复制为 .env 后填入真实值。.env 已在 .gitignore 中，密钥不会进版本库。
#
#   cp .env.example .env

# ── LLM(OpenAI 兼容 /chat/completions)───────────────────────────────
MATHMATE_LLM_BASE_URL=https://your-gateway.example.com/v1
MATHMATE_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
MATHMATE_LLM_MODEL=my-combo

# 视觉模型。留空则与 MATHMATE_LLM_MODEL 相同。
# MATHMATE_LLM_VISION_MODEL=my-combo

# 单次请求超时(秒)。整页作业识别通常 10-30s，留足余量。
MATHMATE_LLM_TIMEOUT=120

# 限流/超时时的重试次数(401、404 这类配置错误不重试)。
MATHMATE_LLM_MAX_RETRIES=2

# 设为 0 强制关闭 LLM，走 NFR-AV-07 降级路径(仅切题 + 教师手动录入)。
# 不设置时以「有没有 API Key」自动判断。
# MATHMATE_LLM_ENABLED=1

# 批量导入时是否让 LLM 重排知识点候选。**默认 0(关)**：
# 288 题实测重排并不比检索更准（同一子集 50.4% vs 52.1%），却要多花钱多等几秒。
# 复现：python scripts/llm_eval_kp.py --n 0
# 教师在校对页单题点「AI 重推」不受此开关影响。
# MATHMATE_LLM_RERANK_KP=0

# ── 数据库 ────────────────────────────────────────────────────────────
# 默认 apps/api/mathmate.db。迁移到 PostgreSQL 时改这里即可。
# MATHMATE_DB_URL=postgresql+psycopg://user:pass@localhost/mathmate

# ── 鉴权(DESIGN §10.1)────────────────────────────────────────────────
# JWT 签名密钥。**不设置时**会在 apps/api/.jwt_secret 自动生成一份本地开发密钥
# (已 gitignore),够本机跑起来;但容器重建、多实例部署都会因此签名不一致,
# 所以任何非本机环境都必须显式设置。生成:python -c "import secrets;print(secrets.token_urlsafe(48))"
# MATHMATE_JWT_SECRET=

# 允许跨域访问 API 的前端来源,逗号分隔。留空则只放行 localhost/127.0.0.1:55101。
# 大屏与教师端由本服务同源托管,只有前端单独部署时才需要配。
# MATHMATE_CORS_ORIGINS=https://mathmate.example.edu
